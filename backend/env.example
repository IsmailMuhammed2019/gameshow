# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/millionaire_game?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS - Comma-separated list of allowed origins
# For development: http://localhost:3000
# For production: https://yourdomain.com,https://www.yourdomain.com
# For all origins (NOT recommended for production): *
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (for reference)
FRONTEND_URL=http://localhost:3000
