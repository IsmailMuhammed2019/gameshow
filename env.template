# FRONTEND_URL=http://94.237.53.19:3000
# NEXT_PUBLIC_API_URL=http://94.237.53.19:3001
# NEXT_PUBLIC_WS_URL=http://94.237.53.19:3001
# ALLOWED_ORIGINS=http://94.237.53.19:3000,http://94.237.53.19:3001
# NODE_ENV=production

