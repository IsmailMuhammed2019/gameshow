# ==========================================
# Millionaire Game Show - Environment Configuration
# ==========================================
# Copy this file to .env and update the values for your deployment

# ==========================================
# DEPLOYMENT CONFIGURATION
# ==========================================

# Your server's IP address or domain name
# Examples: 
#   - 192.168.1.100 (local network)
#   - 94.237.53.19 (public IP)
#   - yourdomain.com (domain name)
SERVER_HOST=localhost

# ==========================================
# BACKEND CONFIGURATION
# ==========================================

# Backend port (default: 3001)
BACKEND_PORT=3001

# JWT Secret (CHANGE THIS IN PRODUCTION!)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node environment
NODE_ENV=production

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# Frontend port (default: 3000)
FRONTEND_PORT=3000

# App name and version
APP_NAME=Millionaire Game
APP_VERSION=1.0.0

# ==========================================
# CORS & URLS
# ==========================================

# Frontend URL (where your frontend is hosted)
# Examples:
#   - http://localhost:3000 (development)
#   - http://192.168.1.100:3000 (local network)
#   - https://yourdomain.com (production with SSL)
FRONTEND_URL=http://localhost:3000

# API URL (where your backend is hosted)
# This is used by the frontend to connect to the backend
# Examples:
#   - http://localhost:3001 (development)
#   - http://192.168.1.100:3001 (local network)
#   - https://api.yourdomain.com (production with SSL)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL (usually same as API URL)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Allowed CORS origins (comma-separated, no spaces after commas)
# Examples:
#   - http://localhost:3000,http://localhost:3001
#   - http://192.168.1.100:3000,http://192.168.1.100:3001
#   - https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
# WARNING: Never use "*" in production!
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Database credentials (CHANGE THESE IN PRODUCTION!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=millionaire_game

# Database port (default: 5432)
POSTGRES_PORT=5432

# ==========================================
# QUICK SETUP FOR DIFFERENT ENVIRONMENTS
# ==========================================

# Uncomment the section that matches your deployment:

# --- LOCAL DEVELOPMENT ---
# SERVER_HOST=localhost
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=http://localhost:3001
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# NODE_ENV=development

# --- LOCAL NETWORK (e.g., 192.168.1.100) ---
# SERVER_HOST=192.168.1.100
# FRONTEND_URL=http://192.168.1.100:3000
# NEXT_PUBLIC_API_URL=http://192.168.1.100:3001
# NEXT_PUBLIC_WS_URL=http://192.168.1.100:3001
# ALLOWED_ORIGINS=http://192.168.1.100:3000,http://192.168.1.100:3001
# NODE_ENV=production

# --- PUBLIC SERVER (e.g., 94.237.53.19) ---
